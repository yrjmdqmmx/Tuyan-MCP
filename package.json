{
  "name": "tuyan-mcp",
  "version": "1.2.1",
  "private": false,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start": "node src/server.js",
    "test": "node scripts/verify-distribution.mjs && node --test tests/*.test.js packages/tuyan-knowledge/tests/*.test.js",
    "check": "node --check src/*.js tests/*.test.js packages/tuyan-knowledge/src/*.js packages/tuyan-knowledge/tests/*.test.js"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@modelcontextprotocol/express": "2.0.0",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@paperbanana/tuyan-knowledge": "file:packages/tuyan-knowledge",
    "express": "4.22.1"
  },
  "devDependencies": {
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1"
  }
}
